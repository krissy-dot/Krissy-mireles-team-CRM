# --- GoHighLevel (GHL) API v2 ---
# This uses a Private Integration Token, not a full OAuth2 app.
# Since this is a single sub-account we own (not a multi-tenant marketplace app),
# a Private Integration is simpler and equally valid for API v2 access.
# Create one in GHL: Sub-account Settings -> Private Integrations -> Create.
# Scopes needed: contacts (read/write), opportunities (read/write), tasks (read/write),
# notes (read/write), tags (read/write), workflows (read + enroll/remove contact).
GHL_PRIVATE_INTEGRATION_TOKEN=
GHL_LOCATION_ID=

# Optional: set once GHL webhook payload signing is wired in (not used by Ticket 1).
GHL_WEBHOOK_SIGNING_SECRET=

# --- Claude API (used starting Ticket 3) ---
ANTHROPIC_API_KEY=

# --- Database (used starting the approval-queue / audit-log tickets) ---
DATABASE_URL=
